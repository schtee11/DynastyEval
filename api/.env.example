# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dynasty_scout

# Auth
JWT_SECRET=change-me-to-a-random-secret

# External APIs (server-side only — never exposed to frontend)
CFBD_API_KEY=your_cfbd_api_key_here

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
